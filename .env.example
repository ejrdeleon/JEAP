APP_NAME="JEAP"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://jeap.store

# Google OAuth Web client. Put the real secret in .env only — never commit it.
# Authorized redirect URIs in Google Cloud:
#   https://jeap.store/auth/google/callback
#   http://127.0.0.1:8080/auth/google/callback
#   http://localhost:8080/auth/google/callback
GOOGLE_CLIENT_ID=623116039331-8jf84vtpvq2rdjof4ir14n7n27opj94m.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://jeap.store/auth/google/callback
GOOGLE_MAPS_BROWSER_KEY=your-google-maps-browser-key
PSGC_API_TOKEN=your-psa-psgc-api-token
PSGC_API_VERSION=Q2_2026

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
HASH_DRIVER=bcrypt
HASH_VERIFY=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jeap
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
EMAIL_VERIFICATION_MINUTES=15
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
# Redis queues are preferred. This project falls back to the database driver when
# Redis / the phpredis extension is not available. To switch later:
#   QUEUE_CONNECTION=redis
#   CACHE_STORE=redis
REDIS_AVAILABLE=false

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@jeap.test"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,127.0.0.1:8080,jeap.store,www.jeap.store
SANCTUM_TOKEN_EXPIRATION=43200
CORS_ALLOWED_ORIGINS=https://jeap.store,https://www.jeap.store,http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:8000,http://localhost:8000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional. Used only by database seeders for demo accounts.
SEED_USER_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
